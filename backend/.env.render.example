# Render Production Environment Variables
# Copy this file to .env.render and fill in your values
# Then set these in Render Dashboard → Environment

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=10000

# ============================================
# DATABASE (Provided by Render PostgreSQL)
# ============================================
# This will be auto-populated from your Render PostgreSQL service
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# ============================================
# REDIS (Provided by Render Redis)
# ============================================
# This will be auto-populated from your Render Redis service
# Format: redis://user:password@host:port
REDIS_URL=

# ============================================
# JWT SECRETS (Generate strong random strings)
# ============================================
# Use: openssl rand -base64 32
JWT_ACCESS_SECRET=your-jwt-access-secret-minimum-32-characters
JWT_REFRESH_SECRET=your-jwt-refresh-secret-minimum-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# SESSION SECRET (Generate strong random string)
# ============================================
# Use: openssl rand -base64 32
SESSION_SECRET=your-strong-session-secret-minimum-32-characters

# ============================================
# CORS ORIGINS (Your frontend URLs)
# ============================================
# Comma-separated list of allowed origins
# Example: https://your-frontend.onrender.com,https://your-admin.onrender.com
CORS_ORIGINS=https://safespace-ug.onrender.com



# ============================================
# EMAIL (SMTP Configuration)
# ============================================
# Gmail Example:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# SendGrid Example:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM=noreply@safespace-ug.com

# ============================================
# APP URLS (For redirects and links)
# ============================================
# These should match your deployed frontend URLs
AUTH_APP_URL=https://ug-safe-space-ug-spacespace-auth-ap.vercel.app
REPORTING_PORTAL_URL=https://ug-safe-space-reporting-portal.vercel.app
PARTICIPATION_PORTAL_URL=https://ug-safe-space-participation-portal.vercel.app
COMMITTEE_DASHBOARD_URL=https://ug-safe-space-committee-dashboard.vercel.app
PUBLIC_PLATFORM_URL=https://ug-safe-space-public-awareness-plat.vercel.app

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
