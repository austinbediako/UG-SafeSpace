# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safespace_ug?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_SECURE_STRING_32_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3105
NODE_ENV=development
CORS_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:3102,http://localhost:3103,http://localhost:3104

# ─── Storage (S3-compatible) ──────────────────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=safespace-evidence
STORAGE_REGION=us-east-1

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@safespace.ug.edu.gh

# ─── App URLs (for redirect and notification links) ──────────────────────────
AUTH_APP_URL=http://localhost:3004
REPORTING_PORTAL_URL=http://localhost:3001
PARTICIPATION_PORTAL_URL=http://localhost:3002
COMMITTEE_DASHBOARD_URL=http://localhost:3003
PUBLIC_PLATFORM_URL=http://localhost:3000
